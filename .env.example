# MediBot Environment Variables Configuration

# General Application Settings
PORT=8000
ENVIRONMENT=development
JWT_SECRET=supersecretjwtkeyforhashingmedibotassessmentspasswords
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Settings
# For local SQLite development (default if Postgres is not running):
DATABASE_URL=sqlite:///./medibot.db
# For PostgreSQL production / docker deployment:
# DATABASE_URL=postgresql://medibot_user:medibot_pass@db:5432/medibot_db

# Gemini API Configuration
# Get your key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Twilio IVR Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# Notification Settings (Email & SMS Reminders)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_app_password_here
SENDER_EMAIL=noreply@medibot.com

# Frontend Environment Variables (for reference)
VITE_API_BASE_URL=http://localhost:8000/api
